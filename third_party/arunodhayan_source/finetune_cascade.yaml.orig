# Fine-tuning config for rung 2/3: arunodhayan's cascade checkpoint.
#
# Deliberately shares nnUNet_raw/nnUNet_preprocessed with baselinerun/ (same working_dir) --
# both rungs operate on the identical Dataset100 (786 cases), and nnU-Net already keeps
# different configurations (3d_lowres vs 3d_fullres vs 3d_cascade_fullres) in separate
# subfolders within one preprocessed tree, which is the standard, expected way to reuse
# preprocessing across configs of the same dataset. Re-preprocessing from scratch here would
# just duplicate large volumes for zero benefit.
#
# output_dir is deliberately its OWN separate root, not baselinerun's outputs/training_run --
# the whole point is that fine-tuned-checkpoint results should be unambiguous at a glance,
# not just another subfolder distinguished by a long nnU-Net config-name string buried inside
# the baseline's output tree.
#
# splits_final.json (in the shared preprocessed dir) is reused as-is from baselinerun -- same
# LOSO/stratified-k-fold splits, which is what makes the before/after fine-tuning comparison
# methodology valid (see README.md's "known validation problem" section): comparing
# arunodhayan's checkpoint against our fine-tuned version on the exact same held-out cases
# baselinerun already validated against.

paths:
  input_dir: "/mnt/workspace/code/datasets/vesuvius-challenge-surface-detection"
  working_dir: "/tmp/vesuvius_training_scratch"                     # SHARED with baselinerun -- same nnUNet_raw/nnUNet_preprocessed tree, deliberately
  output_dir: "/mnt/workspace/code/outputs/finetune_run"             # SEPARATE from baselinerun's outputs/training_run -- clearly demarcated

dataset:
  dataset_id: 100                    # same dataset as baselinerun -- same 786 cases, same splits_final.json

training:
  fold: 0                            # matches baselinerun's LOSO split (scroll 26010 held out) -- see caveat in README
  configuration: "3d_cascade_fullres"
  planner: "nnUNetPlannerResEncM"
  plans_name: "nnUNetResEncUNetMPlans"   # same plans family as baselinerun -- plans.json already declares this as next_stage
  num_workers: null
  epochs: null                        # TBD once we scope the actual fine-tuning schedule (shorter than from-scratch, starting point is already ~8000-epoch-converged)
  command_timeout: null
  num_gpus: null
  seed: 42                            # same seed convention as baselinerun

# Pretrained source checkpoints (arunodhayan, 3rd place) -- not yet downloaded into checkpoints/.
# Both are required: the cascade stage consumes the lowres stage's own predictions on the
# training set as an extra input channel, so it cannot run/fine-tune standalone.
pretrained:
  lowres_checkpoint: "checkpoints/3dlowres_checkpoint_best.pth"          # arunodhayan/cascade dataset
  cascade_checkpoint: "checkpoints/Cascade_fullres_checkpoint_best.pth"  # arunodhayan/cascade-updated model
